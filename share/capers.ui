            <property name="fill">True</property>
          </packing>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="cancel">cancelbutton2</action-widget>
      <action-widget response="ok">okbutton2</action-widget>
    </action-widgets>
  </object>
  <object class="GtkMenu" id="Menu">
  </object>
</interface>
