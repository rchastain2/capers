#!/usr/bin/env python3

"""Capers - play at draughts

This is just a small launcher, the classes themselves are imported
from the capers module.

PORT NOTE: ported from the original PyGTK2 launcher. Requires
Python 3 and PyGObject with the GTK 3 typelib (python3-gi /
PyGObject + gir1.2-gtk-3.0 on most Linux distributions).

Locating capers.py works the same way in both layouts, share/ is
always a *child* of the directory holding this launcher:
- run straight from the source tree (./capers)
- run after "make install": the launcher is installed into
  $(APP_DIR), next to share/, lib/ and games/, and $(BIN_DIR)/capers
  is only a symbolic link to it (see the top-level Makefile), so the
  link is resolved first
"""

import sys
import os
appdir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(1, os.path.join(appdir, 'share'))
import capers

import signal
signal.signal(signal.SIGINT, signal.SIG_DFL)

if __name__ == '__main__':
	main = capers.Main()
